{
  "name": "zovo-jsonl-viewer",
  "displayName": "JSONL Viewer & NDJSON Viewer (JSONL Table)",
  "description": "JSONL viewer and NDJSON viewer that opens .jsonl, .ndjson and .log files as a table, as pretty records or as a chat view for LLM datasets. Hide and resize columns. Fast on large files. Offline.",
  "version": "0.2.0",
  "publisher": "zovo",
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#14213D",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=18"
  },
  "categories": [
    "Data Science",
    "Visualization",
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "ndjson viewer",
    "jsonl table",
    "large jsonl",
    "jsonl viewer",
    "jsonl preview",
    "jsonl",
    "ndjson",
    "json lines",
    "jsonlines",
    "json",
    "viewer",
    "preview",
    "table",
    "dataset",
    "fine-tuning",
    "log viewer",
    "chat",
    "evals",
    "llm",
    "logs",
    "structured logs",
    "large files",
    "huggingface",
    "machine learning",
    "data science",
    "filter",
    "search",
    "schema",
    "export csv",
    "offline"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "jsonlViewer.viewer",
        "displayName": "JSONL Viewer & NDJSON Table Viewer",
        "selector": [
          {
            "filenamePattern": "*.jsonl"
          },
          {
            "filenamePattern": "*.ndjson"
          },
          {
            "filenamePattern": "*.jsonlines"
          },
          {
            "filenamePattern": "*.jsonl.gz"
          },
          {
            "filenamePattern": "*.ndjson.gz"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "jsonlViewer.open",
        "title": "Open in JSONL Viewer",
        "category": "JSONL Viewer",
        "icon": "$(table)"
      },
      {
        "command": "jsonlViewer.openAny",
        "title": "Open as JSON Lines (any file)",
        "category": "JSONL Viewer"
      },
      {
        "command": "jsonlViewer.getStarted",
        "title": "Get Started",
        "category": "JSONL Viewer"
      },
      {
        "command": "jsonlViewer.supportDeveloper",
        "title": "Support the developer",
        "category": "JSONL Viewer"
      },
      {
        "command": "jsonlViewer.moreViewers",
        "title": "More free viewers",
        "category": "JSONL Viewer"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "jsonlViewer.open",
          "when": "resourceFilename =~ /\\.(jsonl|ndjson|jsonlines)(\\.gz)?$/i",
          "group": "navigation@20"
        },
        {
          "command": "jsonlViewer.openAny",
          "when": "!explorerResourceIsFolder && resourceFilename =~ /\\.(log|json|txt|out|data|jsonl\\.txt)$/i",
          "group": "navigation@21"
        }
      ],
      "editor/title": [
        {
          "command": "jsonlViewer.open",
          "when": "resourceFilename =~ /\\.(jsonl|ndjson|jsonlines)$/i && activeEditor == workbench.editors.files.textFileEditor",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "jsonlViewer.open",
          "when": "resourceFilename =~ /\\.(jsonl|ndjson|jsonlines)(\\.gz)?$/i"
        },
        {
          "command": "jsonlViewer.openAny",
          "when": "resourceSet && resourceScheme != untitled"
        }
      ],
      "editor/title/context": [
        {
          "command": "jsonlViewer.openAny",
          "when": "resourceScheme != untitled",
          "group": "navigation@30"
        }
      ]
    },
    "configuration": {
      "title": "JSONL Viewer",
      "properties": {
        "jsonlViewer.liveTail": {
          "type": "boolean",
          "default": true,
          "description": "Add new records while the file grows (for logs that are still being written). The file is checked every 2 s while its tab is visible, and on file change events."
        },
        "jsonlViewer.askForRating": {
          "type": "boolean",
          "default": true,
          "description": "Ask one time for a Marketplace rating after you have used JSONL Viewer for a few days. You can answer \"Later\" or \"Don't ask again\". Nothing is sent anywhere."
        },
        "jsonlViewer.showSupportLinks": {
          "type": "boolean",
          "default": true,
          "description": "Show the small Sponsor and More free viewers links at the right end of the viewer's status line. The change shows in files you open next. Nothing is sent anywhere."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "jsonlViewer.start",
        "title": "Get started with JSONL Viewer",
        "description": "Open a JSON Lines file as a table, a record tree or a chat.",
        "steps": [
          {
            "id": "open",
            "title": "Open a .jsonl or .ndjson file",
            "description": "Click any .jsonl, .ndjson, .jsonlines or .jsonl.gz file. It opens as a table. To see the plain text, click Open as Text.\n[Find a .jsonl file](command:workbench.action.quickOpen?%5B%22.jsonl%22%5D)",
            "media": {
              "markdown": "walkthrough/open.md"
            },
            "completionEvents": [
              "onCommand:workbench.action.quickOpen"
            ]
          },
          {
            "id": "find",
            "title": "Find and filter",
            "description": "Type text in Find, or a filter such as level == error and ctx.ms > 500, then press Enter. The whole file is searched in the background and you can cancel at any time.",
            "media": {
              "markdown": "walkthrough/find.md"
            }
          },
          {
            "id": "chat",
            "title": "Read a chat dataset",
            "description": "Files with messages (OpenAI style), conversations (ShareGPT) or role and content open in the Chat view, with tool calls shown inline.",
            "media": {
              "markdown": "walkthrough/chat.md"
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.js --production",
    "test": "node --test test/*.test.js",
    "samples": "node scripts/make-samples.js",
    "vscode:prepublish": "node scripts/build.js --production",
    "package": "npx -y @vscode/vsce@3 package -o dist/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/theluckystrike/jsonl-viewer-vscode"
  },
  "homepage": "https://github.com/theluckystrike/jsonl-viewer-vscode#readme",
  "bugs": {
    "url": "https://github.com/theluckystrike/jsonl-viewer-vscode/issues"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "esbuild": "^0.24.2"
  },
  "sponsor": {
    "url": "https://github.com/sponsors/theluckystrike"
  }
}
